---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import ArticleSearch from "@/components/react/ArticleSearch/ArticleSearch";
import { loadArticleCatalogue } from "@/lib/articles/loadCatalogue";

const catalogue = await loadArticleCatalogue();
---

<BaseLayout title="Articles - Andrew Gilliland">
  <Container class="min-h-screen pb-14">
    <PageHeader
      title="Articles"
      eyebrow={`Writing · ${catalogue.articles.length} articles · ${catalogue.topics.length} topics`}
    />
    <script is:inline>
      // Runs before the results are parsed: with filters in the URL, hide the
      // server-rendered (unfiltered) results until ArticleSearch applies them.
      // The timeout keeps a failed hydration from hiding the list for good.
      if (/[?&](q|tag)=[^&]/.test(location.search)) {
        const root = document.documentElement;
        root.setAttribute("data-article-search-pending", "");
        setTimeout(
          () => root.removeAttribute("data-article-search-pending"),
          3000,
        );
      }
    </script>
    <ArticleSearch articles={catalogue.listing} client:load />
  </Container>
</BaseLayout>

<style is:global>
  html[data-article-search-pending] [data-article-results] {
    visibility: hidden;
  }
</style>
