---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BackLink from "@/components/BackLink.astro";
import ColorDivider from "@/components/ColorDivider.astro";
import Container from "@/components/Container.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import RelatedArticlesSection from "@/components/articles/RelatedArticlesSection.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import MobileTOC from "@/components/MobileTOC.astro";
import ProgressBar from "@/components/ProgressBar.astro";
import Tag from "@/components/Tag.astro";
import CopyCodeButton from "@/components/CopyCodeButton.astro";
import { render } from "astro:content";
import { loadArticleCatalogue } from "@/lib/articles/loadCatalogue";
import { articleTitleTransitionName } from "@/lib/slug";
import { tocEntries } from "@/lib/articles/toc";

export async function getStaticPaths() {
  const catalogue = await loadArticleCatalogue();
  return catalogue.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, related: catalogue.related(article, 3) },
  }));
}

const { article, related } = Astro.props;
const { Content, headings } = await render(article.entry);
const toc = tocEntries(headings);
const hasToc = toc.length > 0;
---

<BaseLayout
  plain
  title={`${article.title} - Andrew Gilliland`}
  description={article.excerpt}
  type="article"
  publishedTime={article.date.toISOString()}
  image={article.shareImage.url}
>
  <Container class="min-h-screen py-14">
    <div
      class:list={[
        hasToc && "lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12",
      ]}
    >
      <div class="mx-auto min-w-0 max-w-prose">
        <BackLink href="/articles" label="Back to Articles" />
        <header class="mt-10">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400">
            Article · <FormattedDate date={article.date} />
          </p>
          <h1
            class="mt-4 text-4xl font-bold leading-tight text-neutral-50 md:text-5xl"
            style={`view-transition-name: ${articleTitleTransitionName(article.slug)}`}
          >
            {article.title}
          </h1>
          {article.topics.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2.5">
              {article.topics.map((tag) => (
                <Tag tag={tag} />
              ))}
            </div>
          )}
          <ColorDivider className="mt-8 h-4 w-full border-2 border-neutral-50" />
        </header>
        <article class="neon-prose prose prose-invert py-12">
          <Content />
        </article>
        <RelatedArticlesSection articles={related} />
      </div>
      {hasToc && (
        <aside class="hidden lg:block">
          <div class="sticky top-10 pt-24">
            <TableOfContents entries={toc} />
          </div>
        </aside>
      )}
    </div>
  </Container>
  {hasToc && <MobileTOC entries={toc} />}
  <ProgressBar />
  <CopyCodeButton />
</BaseLayout>
