---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BentoTile from "@/components/home/BentoTile.astro";
import ColorDivider from "@/components/ColorDivider.astro";
import Container from "@/components/Container.astro";
import CountUp from "@/components/CountUp.astro";
import ShapeDecoration from "@/components/ShapeDecoration.astro";
import { DARK_SHAPE_STROKE } from "@/lib/shapeColors";
import FormattedDate from "@/components/FormattedDate.astro";
import { projects } from "@/data/projects";
import { getCollection } from "astro:content";
import { toSlug } from "@/lib/slug";
import { topicUrl } from "@/lib/articles/urls";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);

const tagCounts = allArticles
  .flatMap((a) => a.data.tags)
  .reduce(
    (acc, tag) => {
      acc[tag] = (acc[tag] ?? 0) + 1;
      return acc;
    },
    {} as Record<string, number>,
  );
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

const recentArticles = [...allArticles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
const [latest, ...moreArticles] = recentArticles;

// Topic chips cycle through the accents; text on every fill is near-black.
const chipFills = [
  "bg-neon-pink",
  "bg-neon-emerald",
  "bg-neon-yellow",
  "bg-neon-cyan",
];
const projectShadows = ["emerald", "yellow", "cyan"] as const;
const eyebrow = "font-mono text-xs uppercase tracking-[0.2em]";
---

<BaseLayout>
  <Container class="lift-in grid auto-rows-[minmax(10rem,auto)] grid-cols-1 gap-6 py-14 md:grid-cols-4">
    <BentoTile
      shadow="pink"
      label="Introduction"
      class="justify-between md:col-span-2 md:row-span-2"
    >
      <div>
        <p class={`${eyebrow} text-neutral-400`}>
          Software engineer · Bloomington, IL
        </p>
        <h1 class="mt-6 text-5xl font-bold leading-none md:text-7xl">
          Hi, I&apos;m <span class="spring-hover">Andrew!</span>
        </h1>
        <p class="mt-6 text-lg text-neutral-300">
          I&apos;m a software engineer writing about AWS, Python, and building
          things on the web. Practical guides, real examples, no fluff.
        </p>
        <a
          href="/articles"
          class="neo-shadow neo-press mt-8 inline-block border-2 border-neutral-950 bg-neon-pink px-5 py-2.5 font-bold text-neutral-950 [--neo-color:theme(colors.neon.cyan)] [--neo-hover:2px] [--neo-offset:4px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-50"
        >
          Read Articles
        </a>
      </div>
      <ColorDivider className="color-divider--slide mt-10 h-4 w-full border-2 border-neutral-950" />
    </BentoTile>

    {latest && (
      <BentoTile
        href={`/articles/${toSlug(latest.id)}`}
        shadow="cyan"
        fill="pink"
        class="relative justify-between overflow-hidden md:col-span-2"
      >
        <ShapeDecoration id={latest.id} stroke={DARK_SHAPE_STROKE} />
        <span class={`relative ${eyebrow} font-semibold`}>
          Latest article ·{" "}
          <FormattedDate date={latest.data.date} class="font-mono" />
        </span>
        <h2 class="relative mt-4 pr-24 text-3xl font-bold leading-tight">
          {latest.data.title}
        </h2>
      </BentoTile>
    )}

    <BentoTile href="/articles" shadow="pink" fill="yellow">
      <span class={`${eyebrow} font-semibold`}>Writing</span>
      <CountUp value={allArticles.length} class="mt-3 text-6xl font-bold" />
      <span class="font-mono text-sm">
        articles · {sortedTags.length} topics
      </span>
    </BentoTile>

    <BentoTile href="/projects/blono-dev" shadow="emerald" fill="cyan">
      <span class={`${eyebrow} font-semibold`}>Community</span>
      <span class="mt-3 text-2xl font-bold leading-tight">
        Organizer, Bloomington-Normal Developers
      </span>
    </BentoTile>

    <BentoTile shadow="emerald" label="Recent Articles" class="md:col-span-2">
      <h2 class={`${eyebrow} text-neutral-400`}>Recent Articles</h2>
      <ul class="mt-4 space-y-4">
        {moreArticles.map((article) => (
          <li>
            <a
              href={`/articles/${toSlug(article.id)}`}
              class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-50"
            >
              <span class="block text-xl font-bold leading-snug group-hover:underline">
                {article.data.title}
              </span>
              <FormattedDate
                date={article.data.date}
                class="font-mono text-xs text-neutral-400"
              />
            </a>
          </li>
        ))}
      </ul>
    </BentoTile>

    <BentoTile shadow="yellow" label="Browse by Topic" class="md:col-span-2">
      <h2 class={`${eyebrow} text-neutral-400`}>Browse by Topic</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {sortedTags.slice(0, 18).map(([tag, count], index) => (
          <li>
            <a
              href={topicUrl(tag)}
              class={`inline-block border-2 border-neutral-950 px-3 py-1 font-mono text-sm font-semibold text-neutral-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-50 ${chipFills[index % chipFills.length]}`}
            >
              {tag} <span class="opacity-80">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    </BentoTile>

    <h2 class="sr-only">Projects</h2>
    {projects.map((project, index) => (
      <BentoTile
        href={project.href}
        shadow={projectShadows[index % projectShadows.length]}
        class={index === 0 ? "md:col-span-2" : ""}
      >
        <span class={`${eyebrow} text-neutral-400`}>
          Project · {project.stack.join(" · ")}
        </span>
        <h3 class="mt-3 text-2xl font-bold">{project.title}</h3>
        <p class="mt-2 text-neutral-300">{project.summary}</p>
      </BentoTile>
    ))}
  </Container>
</BaseLayout>
