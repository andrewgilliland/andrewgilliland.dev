---
import FormattedDate from "@/components/FormattedDate.astro";
import { fillClass, neoColorClass, type Accent } from "@/lib/accents";

interface Props {
  href: string;
  title: string;
  date: Date;
  headingTag?: "h3" | "h4";
  /** Colour of the offset shadow and the arrow tile. */
  accent?: Accent;
}

const {
  href,
  title,
  date,
  headingTag: Heading = "h3",
  accent = "pink",
} = Astro.props as Props;
---

<li>
  <a
    class={`flex h-full items-center justify-between gap-6 border-2 border-neutral-50 bg-neon-surface p-5 text-neutral-50 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-50 neo-shadow neo-press [--neo-offset:6px] ${neoColorClass[accent]}`}
    href={href}
  >
    <div>
      <Heading class="text-xl font-bold leading-tight">{title}</Heading>
      <FormattedDate
        date={date}
        class="mt-3 block font-mono text-xs uppercase tracking-[0.2em] text-neutral-400"
      />
    </div>
    <div
      class={`flex h-10 w-10 shrink-0 items-center justify-center border-2 border-neutral-950 text-neutral-950 ${fillClass[accent]}`}
      aria-hidden="true"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </div>
  </a>
</li>
