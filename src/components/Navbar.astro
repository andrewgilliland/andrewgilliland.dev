---
import MobileNavbar from "./MobileNavbar.astro";
import DesktopNavbar from "./DesktopNavbar.astro";
import { navLinks } from "@/lib/navigation";

const links = navLinks(Astro.url.pathname);
---

<!-- z-40: the view-transition-name makes the header its own stacking
     context, so the mobile menu's z-index only counts inside it. Page tiles
     with translate animations form stacking contexts too and come later in
     the page, so without this they paint over the open menu. -->
<header class="relative z-40 bg-neon-bg [view-transition-name:site-header]">
  <MobileNavbar links={links} />
  <DesktopNavbar links={links} />
</header>
