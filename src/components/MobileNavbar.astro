---
import Container from "./Container.astro";
import HeaderHeading from "./HeaderHeading.astro";
import type { NavLink } from "@/lib/navigation";

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<div class="relative z-40 w-full border-b-2 border-neutral-50 bg-neon-bg py-6 md:hidden">
  <Container class="flex items-center justify-between">
    <HeaderHeading />
    <button id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="h-10 w-10 transition ease-linear"
        id="menu-icon"
      >
        <path
          id="line-top"
          class="menu-line fill-neon-pink transition-opacity"
          fill-rule="evenodd"
          d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75Z"
        ></path>
        <path
          id="line-mid-1"
          class="menu-line origin-center fill-neon-pink transition ease-linear"
          fill-rule="evenodd"
          d="M3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Z"
        ></path>
        <path
          id="line-mid-2"
          class="menu-line origin-center fill-neon-cyan transition ease-linear"
          fill-rule="evenodd"
          d="M3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Z"
        ></path>
        <path
          id="line-bottom"
          class="menu-line fill-neon-yellow transition-opacity"
          fill-rule="evenodd"
          d="M3 17.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z"
        ></path>
      </svg>
    </button>
  </Container>
</div>

<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="absolute left-0 right-0 top-full z-30 -translate-y-full border-x-2 border-b-2 border-neutral-50 bg-neon-bg transition-all duration-300 md:hidden"
>
  <Container>
    <nav
      aria-label="Main"
      class="my-10 flex h-full flex-col items-stretch gap-4"
    >
      {links.map(({ href, title, ariaCurrent, active }) => (
        <a
          href={href}
          aria-current={ariaCurrent}
          data-foley-click="tap"
          class:list={[
            "border-2 px-4 py-3 text-center text-3xl font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-50",
            active
              ? "neo-shadow neo-press border-neutral-950 bg-neon-pink text-neutral-950 [--neo-color:theme(colors.neon.cyan)] [--neo-offset:4px]"
              : "border-neutral-50 text-neutral-50",
          ]}
        >
          {title}
        </a>
      ))}
    </nav>
  </Container>
</div>

<script is:inline>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");
  const [lineTop, lineMid1, lineMid2, lineBottom] =
    document.querySelectorAll(".menu-line");

  function closeMenu() {
    menu.classList.remove("translate-y-0");
    menu.classList.add("-translate-y-full");
    toggle.setAttribute("aria-expanded", "false");
    icon.classList.remove("rotate-180");
    lineMid1.classList.remove("-rotate-[135deg]");
    lineMid2.classList.remove("rotate-[135deg]");
    lineTop.classList.remove("opacity-0");
    lineBottom.classList.remove("opacity-0");
  }

  function openMenu() {
    menu.classList.add("translate-y-0");
    menu.classList.remove("-translate-y-full");
    toggle.setAttribute("aria-expanded", "true");
    icon.classList.add("rotate-180");
    lineMid1.classList.add("-rotate-[135deg]");
    lineMid2.classList.add("rotate-[135deg]");
    lineTop.classList.add("opacity-0");
    lineBottom.classList.add("opacity-0");
  }

  toggle.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle.focus();
    }
  });
</script>
