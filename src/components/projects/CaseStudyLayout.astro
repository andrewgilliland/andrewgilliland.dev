---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BackLink from "@/components/BackLink.astro";
import ColorDivider from "@/components/ColorDivider.astro";
import Container from "@/components/Container.astro";
import CaseStudySection from "./CaseStudySection.astro";
import { projectBySlug, type ProjectSlug } from "@/data/projects";
import { shareImageIds, shareImageUrl } from "@/lib/og/shareImages";

interface Props {
  /** Which project this case study is about; its record supplies the header and tech stack. */
  slug: ProjectSlug;
}

const project = projectBySlug(Astro.props.slug);
const { title, description, link, linkLabel, techStack } = project;
const image = shareImageUrl(shareImageIds.project(project.href));
---

<BaseLayout
  title={`${title} - Andrew Gilliland`}
  description={description}
  image={image}
  plain
>
  <Container class="pb-20 pt-14">
    <div class="mx-auto max-w-prose">
      <BackLink href="/projects" label="Back to Projects" />
      <header class="mt-10">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400">
          Case study
        </p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-neutral-50 md:text-5xl">
          {title}
        </h1>
        <p class="mt-6 text-lg text-neutral-300">{description}</p>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={link}
          class="neo-shadow neo-press mt-8 inline-block border-2 border-neutral-950 bg-neon-pink px-5 py-2.5 font-bold text-neutral-950 [--neo-color:theme(colors.neon.cyan)] [--neo-hover:2px] [--neo-offset:4px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-50"
        >
          {linkLabel}
        </a>
        <ColorDivider className="mt-10 h-4 w-full border-2 border-neutral-50" />
      </header>

      <slot />

      <CaseStudySection title="Tech Stack">
        <ul class="flex flex-wrap gap-2.5">
          {techStack.map((tech) => (
            <li class="border-2 border-neutral-600 px-2.5 py-1 font-mono text-xs font-semibold text-neutral-300">
              {tech}
            </li>
          ))}
        </ul>
      </CaseStudySection>
    </div>
  </Container>
</BaseLayout>
