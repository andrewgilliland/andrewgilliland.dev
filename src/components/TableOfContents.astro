---
// The desktop table of contents, in the article page's sidebar. The page only
// renders it when tocEntries() found something to list.
import TocList from "@/components/TocList.astro";
import type { TocEntry } from "@/lib/articles/toc";

interface Props {
  entries: TocEntry[];
}

const { entries } = Astro.props;
---

<nav id="toc-sidebar" aria-label="Table of contents">
  <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-neutral-400">
    Table of Contents
  </p>
  <TocList entries={entries} />
</nav>
