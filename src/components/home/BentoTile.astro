---
import {
  fillClass,
  neoColorClass,
  shadowClass,
  type Accent,
} from "@/lib/accents";

interface Props {
  /** Colour of the offset shadow. */
  shadow: Accent;
  /** Fills the tile with an accent; text switches to near-black for contrast. */
  fill?: Accent;
  /** Renders the tile as a link when set. */
  href?: string;
  /** Accessible name when the tile is a section. */
  label?: string;
  class?: string;
}

const { shadow, fill, href, label, class: className = "" } = Astro.props;

const classes = [
  "flex flex-col border-2 border-neutral-50 p-6",
  fill
    ? `${fillClass[fill]} text-neutral-950`
    : "bg-neon-surface text-neutral-50",
  href ? `neo-shadow neo-press ${neoColorClass[shadow]}` : shadowClass[shadow],
  href &&
    "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-50",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <section class={classes} aria-label={label}>
    <slot />
  </section>
)}
